# ─────────────────────────────────────────────
# OpenSwarm — environment configuration
# Copy this file to .env and fill in your keys.
# Run `python run.py` to launch the onboarding
# wizard, which fills this file automatically.
# ─────────────────────────────────────────────


# ── Provider (one required) ───────────────────

# OpenAI — set this if using OpenAI as your primary provider.
OPENAI_API_KEY=

# Anthropic Claude — set this if using Anthropic as your primary provider.
ANTHROPIC_API_KEY=

# Google Gemini — set this if using Google as your primary provider.
GOOGLE_API_KEY=


# ── Model selection ───────────────────────────

# Override the default model for all agents (set automatically by onboarding).
# OpenAI example:   DEFAULT_MODEL=gpt-5.4
# Anthropic example: DEFAULT_MODEL=litellm/claude-sonnet-4-6
# Google example:   DEFAULT_MODEL=litellm/gemini/gemini-3-flash
#
# Claude Max SUBSCRIPTION (ZERO per-token API billing):
#   DEFAULT_MODEL=claude-cli            (or claude-cli:sonnet to pin a model)
# Runs the whole agency through the `claude` CLI (`claude -p`) on your Claude Max
# subscription. Requires the claude CLI installed and logged into Claude Max
# (`claude` on PATH); uses NO API keys — leave the provider keys above blank.
# You can also force this path with CLAUDE_SUBSCRIPTION=1 regardless of DEFAULT_MODEL.
DEFAULT_MODEL=


# ── Optional: Composio ───────────────────────

# Composio unlocks 10,000+ external integrations (Gmail, Slack, Google Calendar,
# HubSpot, GitHub, and more) for the General Agent.
# Get your key and user ID at https://composio.dev
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=


# ── Optional: Search ─────────────────────────

# Search API key — enables web search (WebSearchTool), Scholar search, and
# product search across agents.
# Get your key at https://www.searchapi.io
SEARCH_API_KEY=


# ── Optional: Images / Video ─────────────────────────

# Google AI / Gemini image + video generation reuses the single GOOGLE_API_KEY
# set under "Provider (one required)" above — image generation, editing, and
# composition (Gemini 2.5 Flash Image, Gemini 3 Pro Image) across Image Agent,
# Slides Agent, and Video Agent, plus Veo video generation (Video Agent).
# Do NOT redeclare GOOGLE_API_KEY here: python-dotenv is last-occurrence-wins,
# so a second blank entry would silently override the provider key above.

# Pexels — stock photo search used by Slides Agent (ImageSearch tool).
# Get your key at https://www.pexels.com/api
PEXELS_API_KEY=

# Pixabay — stock photo search used by Slides Agent (ImageSearch tool).
# Get your key at https://pixabay.com/api/docs
PIXABAY_API_KEY=

# Unsplash — stock photo search used by Slides Agent (ImageSearch tool).
# Get your key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# fal.ai — used for Seedance 1.5 Pro video generation, video editing (Video Agent),
# and background removal (Image Agent).
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=


# ── Optional: Knowledge vault + memory ───────────
# Obsidian vault — a directory of Markdown notes the swarm can search, read, and
# write generated notes into (VaultSearch/VaultRead/VaultWrite + Publisher). Never writes under Sources/.
OBSIDIAN_VAULT=/Users/jasonluo08/Desktop/AI Brain
# Persistent memory — append-only JSON the swarm recalls across runs (RememberFact/RecallMemory).
SWARM_MEMORY_PATH=~/.openswarm/swarm_memory.json

# ── Optional: Publishing / YouTube ───────────────
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_FILE=

# ── Optional: Always-on scheduler (scheduler/scheduler.py) ──
SWARM_JOBS_FILE=scheduler/jobs.yaml
SWARM_BASE_URL=http://localhost:8080
SWARM_AGENCY=open-swarm
SWARM_APP_TOKEN=
SWARM_RUNS_LOG=scheduler/runs.log

# ── Optional: Scheduler reliability (run ledger + retries) ──
SWARM_RUNS_JSONL=~/.openswarm/runs.jsonl        # structured per-run ledger (one JSON line per fire)
SWARM_RUNS_JSONL_MAX_BYTES=5242880              # size-based rotation
SWARM_MAX_RETRIES=2                             # transient-failure retries (connect-phase only)
SWARM_RETRY_BASE_DELAY=1.0                      # backoff base seconds

# ── Optional: Narrated shorts (reuses ~/Content/reddit-shorts) ──
REDDIT_SHORTS_PATH=/Users/jasonluo08/Content/reddit-shorts   # importable reddit_shorts package
REDDIT_SHORTS_CONFIG=                            # optional explicit config path

# ── Optional: Scheduler failure notifications ──
SWARM_NOTIFICATIONS=~/.openswarm/notifications.jsonl   # durable JSONL alert sink
SWARM_AIEOS_URL=http://127.0.0.1:7824                   # AIEOS timeline base URL (unset = POST fallback off)
SWARM_NOTIFY_MIN_INTERVAL=3600                          # seconds to suppress a duplicate failure alert
